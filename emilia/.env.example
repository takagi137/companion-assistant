# Copy to .env and run npm start (Node.js 24+).
# .env is private and ignored by Git. Existing process variables take precedence.
# Do not put credentials in dist/, source code, or command-line arguments.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-max
HOST=127.0.0.1
PORT=4174
# Optional SQLite path; default is ./data/emilia.sqlite beside server.mjs.
# SORA_DATABASE_PATH=/app/data/emilia.sqlite

# For a public deployment, uncomment and fill ALL of these:
# NODE_ENV=production
# HOST=0.0.0.0
# APP_ORIGIN=https://companion.example.com
# SORA_ACCESS_PASSWORD=replace-with-your-own-random-password
# SORA_MIN_PASSWORD_LENGTH=16
# The SORA_ prefix is shared by both editions for compatibility.
